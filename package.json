{
  "name": "notes_graph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "copy-relate": "mkdir -p public/relate && cp node_modules/@relate/relate-wasm/relate.js node_modules/@relate/relate-wasm/relate_bg.wasm node_modules/@relate/relate-wasm/trap.js public/relate/ && cp -R node_modules/@relate/relate-wasm/snippets public/relate/",
    "predev": "npm run copy-relate",
    "dev": "vite",
    "prebuild": "npm run copy-relate",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@neo4j-nvl/base": "^2.1.0",
    "@neo4j-nvl/interaction-handlers": "^2.1.0",
    "@relate/relate-wasm": "^1.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "compromise": "^14.20.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
